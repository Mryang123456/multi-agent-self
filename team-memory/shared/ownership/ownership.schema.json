{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent/schemas/ownership.schema.json",
  "title": "Active File Ownership Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "leases"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "leases": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "taskId", "agent", "mode", "paths", "exclusive", "acquiredAt", "expiresAt", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "taskId": {"type": "string", "minLength": 1}, "agent": {"type": "string", "minLength": 1},
        "mode": {"enum": ["read", "write"]}, "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exclusive": {"type": "boolean"},
        "baseHashes": {"type": "object", "additionalProperties": {"type": "string"}},
        "acquiredAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["active", "released", "expired", "revoked"]}, "note": {"type": "string"}
      }
    }}
  }
}

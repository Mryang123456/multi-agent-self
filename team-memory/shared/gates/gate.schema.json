{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.multi-agent/schemas/gate.schema.json",
  "title": "Five-Stage Gate Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "stages"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "ownerRole", "entry", "outputs", "exitCriteria"],
        "properties": {
          "id": {"enum": ["S1", "S2", "S3", "S4", "S5"]},
          "name": {"type": "string"},
          "ownerRole": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "entry": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "exitCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requiredChecks": {"type": "array", "items": {"type": "string"}},
          "blockingSeverities": {"type": "array", "items": {"enum": ["P0", "P1", "security", "data-integrity"]}}
        }
      }
    }
  }
}

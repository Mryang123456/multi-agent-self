{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/runtime/services.schema.json",
  "title": "Multi-agent local runtime service registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "version": { "const": 1 },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "name", "kind", "host", "port", "required"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["frontend", "backend", "database", "support"] },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "sessionId": { "type": ["string", "integer", "null"] },
        "ownerAgent": { "type": ["string", "null"] },
        "buildId": { "type": ["string", "null"] },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "required": { "type": "boolean" },
        "health": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["http", "tcp"] },
            "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
          }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": []
        }
      },
      "allOf": [
        {
          "if": { "properties": { "health": { "properties": { "type": { "const": "http" } } } } },
          "then": { "properties": { "health": { "required": ["type", "url"] } } }
        }
      ]
    }
  }
}
